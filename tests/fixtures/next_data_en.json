pter_id": "95v82dtkhj", "status": 1, "like_count": 8252, "chapter_weight": 1, "publish_at": 1784011805, "chapter_type": 1, "serial_number": 43, "video_pic": "https://v-mps.crazymaplestudios.com/Snapshots/7a817e5ecb3b9060.jpg"}, {"chapter_id": "r0lc3ktjbr", "status": 1, "like_count": 9425, "chapter_weight": 1, "publish_at": 1784011805, "chapter_type": 1, "serial_number": 44, "video_pic": "https://v-mps.crazymaplestudios.com/Snapshots/19980a005a5925d4.jpg"}, {"chapter_id": "8oil2iyb9x", "status": 1, "like_count": 6970, "chapter_weight": 1, "publish_at": 1784011805, "chapter_type": 1, "serial_number": 45, "video_pic": "https://v-mps.crazymaplestudios.com/Snapshots/04695d7fdd85eaf0.jpg"}, {"chapter_id": "mllsv93g9h", "status": 1, "like_count": 8994, "chapter_weight": 1, "publish_at": 1784011805, "chapter_type": 1, "serial_number": 46, "video_pic": "https://v-mps.crazymaplestudios.com/Snapshots/7028482ba5588a16.jpg"}, {"chapter_id": "42vyw0fz22", "status": 1, "like_count": 8656, "chapter_weight": 1, "publish_at": 1784011805, "chapter_type": 1, "serial_number": 47, "video_pic": "https://v-mps.crazymaplestudios.com/Snapshots/7e3f939288598c5e.jpg"}, {"chapter_id": "83qvtbovxw", "status": 1, "like_count": 8937, "chapter_weight": 1, "publish_at": 1784011805, "chapter_type": 1, "serial_number": 48, "video_pic": "https://v-mps.crazymaplestudios.com/Snapshots/37f9e71addfcbca3.jpg"}, {"chapter_id": "4pgtvc039o", "status": 1, "like_count": 6481, "chapter_weight": 1, "publish_at": 1784011805, "chapter_type": 1, "serial_number": 49, "video_pic": "https://v-mps.crazymaplestudios.com/Snapshots/eb6b64141cf0422e.jpg"}, {"chapter_id": "up90y90d2y", "status": 1, "like_count": 7077, "chapter_weight": 1, "publish_at": 1784011805, "chapter_type": 1, "serial_number": 50, "video_pic": "https://v-mps.crazymaplestudios.com/Snapshots/721d0cf9f6bfeedd.jpg"}, {"chapter_id": "zcmlqggbkj", "status": 1, "like_count": 20841, "chapter_weight": 1, "publish_at": 1784011805, "chapter_type": 1, "serial_number": 51, "video_pic": "https://v-mps.crazymaplestudios.com/Snapshots/525a0c8ba55d67a8.jpg"}], "paid_start": 10, "collect_count": 7630343, "t_book_id": "204200150000005664", "online_at": 1784011800, "publish_at": 1784012406, "is_dub": 0, "tag": ["Playing Dumb"], "book_genre": 15, "special_desc": "<p style=\"margin-bottom: 1.2em;\">Elijah Baran is a genie in a magic lamp who spent thousands of years granting three wishes to one generation after another in The Great and Powerful Genie. All that time, he secretly wanted one thing for himself: freedom. He never thought anyone would be willing to set him free. Then billionaire Steven Parrish offered him a deal—marry his granddaughter, remain a loyal husband for five years, and Elijah would finally be free.</p>\n\n<p style=\"margin-bottom: 1.2em;\">To keep his end of the bargain, Elijah took human form and kept his identity hidden. He became exactly what Christine needed: loyal, hard-working, and passionate. He did everything he could to help her become a successful CEO. None of it mattered to Christine. The kinder Elijah was to her, the worse she treated him.</p>\n\n<p style=\"margin-bottom: 1.2em;\">After five years of being taken for granted, Elijah had had enough. He divorced Christine without hesitation, took back everything he had given her, and left her to fend for herself with her deceptive ex. Elijah moved past the heartbreak. In time, he found a woman who could see his value, with or without his magic.</p>\n\n<p style=\"margin-bottom: 1.2em;\">Christine didn’t realize how wrong she had been until Elijah began to rise without her. She begged him to stay and swore that she had loved him all along. But she had waited too long. Elijah was no longer the same man she once knew.</p>\n\n<h4 style=\"font-size: 1.2em; font-weight: 700; line-height: 1.4; margin-top: 1.5em; margin-bottom: 1em;\">Characters</h4>\n\n<h5 style=\"font-size: 1.05em; font-weight: 700; line-height: 1.4; margin-top: 1.2em; margin-bottom: 0.4em;\">Elijah Baran</h5>\n<p style=\"margin-bottom: 1.2em;\">Elijah Baran is the lead protagonist of The Great and Powerful Genie. He’s a powerful yet compassionate mythical being who craves freedom more than anything. He is willing to swallow his pride and risk heartbreak if it means finally escaping the constraints of his magical existence.</p>\n\n<h5 style=\"font-size: 1.05em; font-weight: 700; line-height: 1.4; margin-top: 1.2em; margin-bottom: 0.4em;\">Christine Parrish</h5>\n<p style=\"margin-bottom: 1.2em;\">Christine Parrish is an ignorant, prideful woman who mistakes wealth for character. She spends her marriage looking down on Elijah and believing he’s unworthy of her love. She eventually faces the consequences of her actions, and her downfall couldn’t be more satisfying.</p>\n\n<h5 style=\"font-size: 1.05em; font-weight: 700; line-height: 1.4; margin-top: 1.2em; margin-bottom: 0.4em;\">Tony Roth</h5>\n<p style=\"margin-bottom: 1.2em;\">Tony Roth is Christine’s ex-boyfriend. He’s arrogant, selfish, and delusional about his importance, believing he deserves Christine more than anyone. His own schemes backfire on him when he discovers the truth about Elijah’s identity.</p>\n\n<h5 style=\"font-size: 1.05em; font-weight: 700; line-height: 1.4; margin-top: 1.2em; margin-bottom: 0.4em;\">Ruby Hiller</h5>\n<p style=\"margin-bottom: 1.2em;\">Ruby Hiller is Elijah’s second chance at love. She’s the granddaughter of another billionaire Elijah helped in the past. Unlike Christine, Ruby knows what she wants, recognizes true humility, and cherishes Elijah the way he deserves.</p>", "has_dub": false, "tag_list": [{"id": "676d21074582b53a14081664", "category_id": "1000", "text": "Male"}, {"id": "676d210c4582b53a140819c1", "category_id": "1010", "text": "Romance"}, {"id": "676d210f4582b53a14081b83", "category_id": "1010001", "text": "Toxic Romance"}, {"id": "676d210c4582b53a140819c7", "category_id": "1011", "text": "Modern"}, {"id": "676d210d4582b53a140819d3", "category_id": "1012", "text": "Emotional"}, {"id": "676d210d4582b53a140819de", "category_id": "1012", "text": "Sentimental"}, {"id": "676d210d4582b53a140819df", "category_id": "1012", "text": "Supernatural"}, {"id": "676d210d4582b53a140819f5", "category_id": "1012", "text": "Feel-Good"}, {"id": "676d210d4582b53a14081a34", "category_id": "1012", "text": "Love Triangle"}, {"id": "676d210e4582b53a14081a67", "category_id": "1013", "text": "USA"}, {"id": "676d210f4582b53a14081b1e", "category_id": "1023", "text": "Mansion"}, {"id": "676d210f4582b53a14081b2a", "category_id": "1023", "text": "Banquet"}, {"id": "676d210f4582b53a14081b25", "category_id": "1023", "text": "Hotel"}, {"id": "676d210e4582b53a14081a7f", "category_id": "1014", "text": "Contemporary"}, {"id": "676d210e4582b53a14081a83", "category_id": "1015", "text": "All Ages"}, {"id": "676d210e4582b53a14081a93", "category_id": "1020", "text": "Heiress/Socialite"}, {"id": "676d210e4582b53a14081aa0", "category_id": "1020", "text": "Assistant"}, {"id": "676d210e4582b53a14081aae", "category_id": "1020", "text": "Immortal"}, {"id": "676d210e4582b53a14081ad9", "category_id": "1020", "text": "Playboy"}, {"id": "676d210e4582b53a14081aab", "category_id": "1020", "text": "Billionaire"}, {"id": "676d210e4582b53a14081aed", "category_id": "1022", "text": "All-Too-Late"}, {"id": "676d210e4582b53a14081ae9", "category_id": "1022", "text": "Love After Divorce"}, {"id": "676d210f4582b53a14081b02", "category_id": "1022", "text": "Hidden Identity"}, {"id": "676d210f4582b53a14081b4e", "category_id": "1024", "text": "Divorce"}, {"id": "676d210f4582b53a14081b70", "category_id": "1024", "text": "Getting Back at Ex"}, {"id": "676d210f4582b53a14081b4d", "category_id": "1024", "text": "Identity Reveal"}], "is_preview": 0, "s_book_id": 136032, "lang": "en", "update_status": 1, "total": 51, "book_type": 1, "book_source": 45, "read_count": 573640357, "is_paid": 1, "book_mark": {"type": 16, "color": "#FFE52E2E", "text_color": "#FFFFFFFF", "text": "Trending"}, "is_