# ToolNet ReelShort Metadata API - Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to git!

# --- Service ---
ENVIRONMENT=production
PORT=8077
LOG_LEVEL=INFO
LOG_FILE=/srv/logs/reelshort-api.log  # Set empty (LOG_FILE=) to disable file logging (Render stdout)
DOCS_ENABLED=true

# --- Storage ---
# Option A: Turso (libSQL) - RECOMMENDED for Render (persistent, free tier)
# Get from: turso db create reelshort-api && turso db tokens create reelshort-api
TURSO_DATABASE_URL=libsql://your-db-name-xyz.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJ...

# Option B: Local SQLite (ephemeral on Render free tier - data lost on restart!)
# DB_PATH=/tmp/data/reelshort.sqlite3
# DATA_DIR=/tmp/data
# BACKUP_DIR=/tmp/data/backups

# --- Auth ---
# Public API keys (comma-separated). Required if PUBLIC_AUTH_ENABLED=true
PUBLIC_API_KEYS=sk_live_yourkey1,sk_live_yourkey2
PUBLIC_AUTH_ENABLED=true

# Admin credentials (REQUIRED for /admin endpoints)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-strong-password  # Generate: openssl rand -base64 32
ADMIN_TOKEN=  # Optional: alternative to password (Bearer token)
ADMIN_AUTH_ENABLED=true

# Trust proxy headers (Render, Cloudflare, nginx)
TRUST_PROXY_HEADERS=true

# --- Crawling ---
SOURCE_BASE_URL=https://www.reelshort.com
SOURCE_TIMEOUT_SECONDS=25.0
SOURCE_MAX_RETRIES=3
SOURCE_BACKOFF_BASE_SECONDS=1.5
SOURCE_BACKOFF_MAX_SECONDS=60.0
SOURCE_REQUESTS_PER_MINUTE=20.0  # Reduce to 10 for Render free tier
SOURCE_BURST=4.0
SOURCE_CONCURRENCY=2  # Reduce to 1 for Render free tier
SOURCE_COOLDOWN_ON_429_SECONDS=300.0
SOURCE_COOLDOWN_ON_403_SECONDS=900.0
SOURCE_BREAKER_ERROR_THRESHOLD=5
RESPECT_ROBOTS_TXT=true
ROBOTS_CACHE_SECONDS=3600.0
USER_AGENT=ToolNetReelShortMetadataBot/1.0 (+https://toolnet.tech; metadata-only; contact: ops@toolnet.tech)

# --- Cache / Freshness ---
METADATA_TTL_HOURS=24.0
CATALOG_TTL_HOURS=12.0
SEARCH_CACHE_TTL_MINUTES=30.0
EDITION_TTL_HOURS=72.0
STALE_WHILE_REVALIDATE=true

# --- Workers ---
WORKER_CONCURRENCY=2  # Reduce to 1 for Render free tier
WORKER_POLL_SECONDS=0.5
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=90.0
DISCOVERY_JOB_TIMEOUT_SECONDS=900.0
CATALOG_JOB_TIMEOUT_SECONDS=7200.0
QUEUE_MAX_SIZE=500
SHUTDOWN_GRACE_SECONDS=15.0

# --- Scheduler (disable on Render free tier - service sleeps) ---
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300.0
SCHEDULER_BATCH_SIZE=10
SCHEDULER_MIN_AGE_HOURS=24.0
AUTO_SYNC_ENABLED=false
AUTO_SYNC_LOCALES=en,vi
ENRICHMENT_BATCH_SIZE=5

# --- Rate Limits (inbound) ---
API_RATE_LIMIT_PER_MINUTE=120
API_RATE_LIMIT_BURST=30
DISCOVER_RATE_LIMIT_PER_HOUR=12
CRAWL_RATE_LIMIT_PER_HOUR=300
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20

# --- Discovery ---
DISCOVERY_LOCALES=vi,en,es,pt,th,id,fr,de,ja,ko,ru,ar
DISCOVERY_MAX_LOCALES_PER_RUN=6
DISCOVERY_SEARCH_PAGES=2
DISCOVERY_TAG_SCAN_PAGES=3
DISCOVERY_TAG_SCAN_PAGE_SIZE=50
DISCOVERY_MAX_CANDIDATES=12
DISCOVERY_CANDIDATE_MIN_SCORE=0.35
DISCOVERY_CANDIDATE_MIN_TITLE_SIMILARITY=0.5
DISCOVERY_MIN_CONFIDENCE=0.5
DISCOVERY_AUTO_VERIFY_CONFIDENCE=0.8
CATALOG_TAG_ID=6348f5093c6ca761764d85f3

# --- Logging format ---
LOG_FORMAT=json  # or "text" for human-readable